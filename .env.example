# Copy to `.env` and fill in secrets. Never commit `.env` (see `.gitignore`).
# Only variable NAMES are listed here — no values.

# --- Required ---
# Postgres connection string (local docker or hosted, e.g. Neon).
DATABASE_URL=
# JWT signing secret (or set JWT_SECRET_KEY instead).
SECRET_KEY=
# Chat LLM: Inception Labs (Mercury, OpenAI-compatible).
INCEPTION_API_KEY=
# Embeddings for RAG (Gemini). Retrieval does not work without this.
GOOGLE_API_KEY=
# Celery broker/backend.
REDIS_URL=

# --- Optional: chat model override (default mercury-2.5) ---
INCEPTION_MODEL=
INCEPTION_BASE_URL=

# --- Optional: Groq fallback (commented standby in app/ai/llm.py) ---
GROQ_API_KEY=
GROQ_MODEL=

# --- Optional: LangSmith tracing passthrough ---
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=

# --- Optional: visual-RAG / OCR keys (placeholders) ---
COLIVARA_API_KEY=
OCR_API_KEY=

# --- Optional: seeded admin account (defaults admin@gmail.com / 12345) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Optional: production frontend URL(s), comma-separated, for CORS ---
FRONTEND_URL=

# --- Upload storage (must match on web + worker) ---
# Local dev: leave unset (defaults to ./uploads).
# Production (Railway): mount the SAME volume into web and worker at
# /data/uploads and set UPLOAD_DIR=/data/uploads on both services,
# otherwise the worker can't see uploaded PDFs and every doc fails.
UPLOAD_DIR=
# Max PDF size in MB (default 25).
MAX_UPLOAD_MB=

# --- Local Postgres (docker-compose local-db use) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
