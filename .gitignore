# Secrets - never commit (contains API keys)
# Matches .env in any folder (root, backend/, frontend/)
.env
# Matches .env.local, .env.development, .env.test, etc. in any folder
.env.*
# Important: templates and non-secret prod URL must stay tracked
!.env.example
!frontend/.env.production

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env/

# Uploaded PDFs and local data (generated at runtime, not source)
uploads/
backend/uploads/
# Project requirements PDF - not required in repo
Project_Requirements.pdf

# Postgres local data (if ever bind-mounted)
postgres_data/
redis_data/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Local databases / coverage
*.sqlite3
*.sqlite
*.sqlite3-journal
htmlcov/
.coverage

# Local git backup - never commit
.git-corrupted/

# Unused / generated - never commit
# figmadesign/ is an unimportant Figma Make prototype (mock UI, not wired
# to backend) - ignore entirely.
figmadesign/
frontend/dist/
frontend/node_modules/
.figma/
node_modules/
dist/
dist-ssr/
build/
coverage/
*.log
logs/
*.tsbuildinfo
.vite/
.cache/
.pytest_cache/
.mypy_cache/
.vercel/
vite.config.*.timestamp-*
.claude-replay.*
.tmp-*
.plugins/
.opencode-skills/
